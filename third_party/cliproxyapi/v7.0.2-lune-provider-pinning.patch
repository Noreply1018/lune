+func providerPinnedAuthMiddleware(baseHandler *handlers.BaseAPIHandler) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		authID := strings.TrimSpace(c.GetHeader("X-CLIProxyAPI-Pinned-Auth-Id"))
+		if authID == "" {
+			authID = pinnedAuthIDByIndex(baseHandler, c.GetHeader("X-CLIProxyAPI-Pinned-Auth-Index"))
+		}
+		if authID == "" {
+			authID = pinnedAuthIDByIndex(baseHandler, c.GetHeader("X-CPA-Auth-Index"))
+		}
+		if authID != "" {
+			c.Request = c.Request.WithContext(handlers.WithPinnedAuthID(c.Request.Context(), authID))
+		}
+		c.Next()
+	}
+}
+
+func pinnedAuthIDByIndex(baseHandler *handlers.BaseAPIHandler, authIndex string) string {
+	authIndex = strings.TrimSpace(authIndex)
+	if authIndex == "" || baseHandler == nil || baseHandler.AuthManager == nil {
+		return ""
+	}
+	for _, auth := range baseHandler.AuthManager.List() {
+		if auth == nil {
+			continue
+		}
+		auth.EnsureIndex()
+		if strings.EqualFold(strings.TrimSpace(auth.Index), authIndex) {
+			return strings.TrimSpace(auth.ID)
+		}
+	}
+	return ""
+}
