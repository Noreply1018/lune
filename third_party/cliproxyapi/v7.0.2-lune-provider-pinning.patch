+func TestRegisterProviderAliases_PinnedAuthIndexHeaderSelectsAuth(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+
+	executor := &providerPinnedAuthCaptureExecutor{}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.RegisterExecutor(executor)
+
+	modelName := "provider-pin-test-model"
+	authA := &coreauth.Auth{ID: "auth-a", Provider: "codex", Status: coreauth.StatusActive}
+	authB := &coreauth.Auth{ID: "auth-b", Provider: "codex", Status: coreauth.StatusActive}
+	reg := registry.GetGlobalRegistry()
+	reg.RegisterClient(authA.ID, "codex", []*registry.ModelInfo{{ID: modelName}})
+	reg.RegisterClient(authB.ID, "codex", []*registry.ModelInfo{{ID: modelName}})
+	t.Cleanup(func() {
+		reg.UnregisterClient(authA.ID)
+		reg.UnregisterClient(authB.ID)
+	})
+	if _, err := manager.Register(context.Background(), authA); err != nil {
+		t.Fatalf("register auth-a: %v", err)
+	}
+	if _, err := manager.Register(context.Background(), authB); err != nil {
+		t.Fatalf("register auth-b: %v", err)
+	}
+	authBIndex := authB.EnsureIndex()
+	if authBIndex == "" {
+		t.Fatal("expected auth-b index")
+	}
+
+	base := handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager)
+	r.POST("/probe", providerPinnedAuthMiddleware(base), func(c *gin.Context) {
+		rawJSON, err := io.ReadAll(c.Request.Body)
+		if err != nil {
+			c.String(http.StatusInternalServerError, err.Error())
+			return
+		}
+		resp, _, errMsg := base.ExecuteWithAuthManager(c.Request.Context(), "openai", modelName, rawJSON, "")
+		if errMsg != nil {
+			c.String(errMsg.StatusCode, errMsg.Error.Error())
+			return
+		}
+		c.Data(http.StatusOK, "application/json", resp)
+	})
+
+	req := httptest.NewRequest(http.MethodPost, "/probe", nil)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-CLIProxyAPI-Pinned-Auth-Index", authBIndex)
+	w := httptest.NewRecorder()
+
+	r.ServeHTTP(w, req)
+	if w.Code != http.StatusOK {
+		body, _ := io.ReadAll(w.Body)
+		t.Fatalf("status = %d, body = %s", w.Code, string(body))
+	}
+
+	got := executor.AuthIDs()
+	if len(got) != 1 || got[0] != "auth-b" {
+		t.Fatalf("executor auth IDs = %v, want [auth-b]", got)
+	}
+}
